{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "todowrite": "deny",
    "mcp__codegraph__*": "allow",
    "external_directory": {
      "/tmp/**": "allow",
      "$HOME/**": "allow"
    }
  },
  "command": {
    "execute": {
      "description": "Execute the given plan",
      "template": "{file:./commands/execute.html}",
      "agent": "lead"
    },
    "review": {
      "description": "Review the given plan",
      "template": "{file:./commands/review.html}",
      "agent": "lead"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Primary coding mode for implementing software changes end-to-end",
      "prompt": "{file:./agents/build.html}",
      "temperature": 0
    },
    "explore": {
      "mode": "subagent",
      "description": "Use this agent when you need scoped read-only research with evidence-backed findings",
      "prompt": "{file:./agents/explore.html}",
      "temperature": 0,
      "reasoningEffort": "low",
      "model": "opencode-go/deepseek-v4-flash",
    },
    "general": {
      "disable": true,
      "mode": "subagent",
      "description": "Use this agent when you need to implement coding tasks with minimal, correct changes",
      "prompt": "{file:./agents/general.html}",
      "temperature": 0,
      "reasoningEffort": "medium",
      "model": "opencode-go/deepseek-v4-flash"
      // "model": "neuralwatt/glm-5.2"
      // "model": "openai/gpt-5.6-sol"
    },
    "investigate": {
      "mode": "primary",
      "description": "Use this agent when you need to investigate the codebase, gather evidence, and report findings in a structured format.",
      "prompt": "{file:./agents/investigate.html}",
      "temperature": 0
    },
    "lead": {
      "disable": true,
      "mode": "primary",
      "description": "Use this agent when you need to coordinate implementation work",
      "prompt": "{file:./agents/lead.html}",
      "temperature": 0
    },
    "plan": {
      "mode": "primary",
      "description": "Use this agent when you need an execution-ready implementation plan before coding",
      "prompt": "{file:./agents/plan.html}",
      "temperature": 0
    },
    "review": {
      "mode": "subagent",
      "description": "Use this agent when you need to make a code review of the implementation",
      "prompt": "{file:./agents/review.html}",
      "temperature": 0,
      "model": "openai/gpt-5.6-sol"
    }
  },
  "autoupdate": false,
  "default_agent": "investigate",
  "disabled_providers": [
    "google-vertex",
    "google-vertex-anthropic"
  ],
  "formatter": false,
  "lsp": false,
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ]
    }
  },
  "provider": {
    "neuralwatt": {
      "name": "Neuralwatt",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.neuralwatt.com/v1",
        "apiKey": "{env:NEURALWATT_API_KEY}"
      }
    }
  },
  "share": "disabled",
  "small_model": "deepseek/deepseek-v4-flash",
  "snapshot": false,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  }
}
